# Copy to .env and fill in. Never commit .env.

# Watchmode: free Developer key from https://api.watchmode.com/requestApiKey/
# Pick US as one of your 3 countries.
WATCHMODE_API_KEY=

# TMDB: "API Read Access Token" (the long v4 token) from https://www.themoviedb.org/settings/api
TMDB_READ_TOKEN=

# Seerr: Settings -> General -> API Key
SEERR_API_KEY=
# From MonkeyServer inside the compose network: http://seerr:5055
# From your Mac on the home network: http://monkeyserver.local:5055
SEERR_URL=http://monkeyserver.local:5055
