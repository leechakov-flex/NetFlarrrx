# Copy to .env and fill in. Never commit .env. No quotes needed around values.

# Watchmode: free Developer key from https://api.watchmode.com/requestApiKey/
# Pick US as one of your 3 countries.
WATCHMODE_API_KEY=

# TMDB: "API Read Access Token" (the long v4 token, starts with eyJ) from https://www.themoviedb.org/settings/api
TMDB_READ_TOKEN=

# Seerr: Settings -> General -> API Key
SEERR_API_KEY=
# Inside the MonkeyServer compose network: http://seerr:5055
# From your Mac on the home network (spike only): http://monkeyserver.local:5055
SEERR_URL=http://seerr:5055

# Protects admin actions now, and requests from M3. Pick anything.
APP_PASSCODE=
# Optional: request as this Seerr user instead of the admin (requests then wait for approval)
# SEERR_USER_ID=

# Optional. Defaults shown.
# LANGUAGE_RULE=en              # en = English-original only; all = every language
# SYNC_CRON=23 6 * * *          # daily at 6:23, in TZ
# TZ=America/New_York
# LOG_LEVEL=info

# Alerts (M5): an ntfy topic URL, e.g. https://ntfy.sh/<a-long-random-topic>, or a Discord webhook URL
# ALERT_URL=
# ALERT_TOKEN=                  # only for a protected ntfy topic
# APP_URL=http://monkeyserver.local:8484   # tapping an alert opens this

# Backups (M5): nightly at 3:41, newest 14 kept. Defaults to /data/backups;
# mount a second disk and point this at it so one drive failure can't take both.
# BACKUP_DIR=/backups
# BACKUP_KEEP=14

# TMDB cross-check (M5): Sundays at 5:17. Alerts when we have under 70% of TMDB's list,
# when under 85% of ours is on TMDB's, or after a 10-point drop.
# CROSSCHECK_MIN_PCT=70
# CROSSCHECK_MIN_AGREE_PCT=85
