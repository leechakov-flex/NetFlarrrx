{
  "name": "monkeysee",
  "version": "0.1.0",
  "private": true,
  "description": "Browse what's new on Netflix US and request titles through Seerr.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.test.json && tsc -p web/tsconfig.json",
    "start": "node --disable-warning=ExperimentalWarning dist/main.js",
    "dev": "tsx --disable-warning=ExperimentalWarning src/main.ts",
    "cli": "tsx --disable-warning=ExperimentalWarning src/cli.ts",
    "test": "vitest run && npm run -s test:spike",
    "test:unit": "vitest run",
    "spike": "node scripts/spike.mjs",
    "test:spike": "node --test test/spike.test.mjs",
    "build:server": "tsc",
    "build:web": "vite build",
    "dev:web": "vite"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "croner": "^11.0.1",
    "hono": "^4.13.19",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@tanstack/react-query": "^5.108.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.7.0",
    "framework7-icons": "^5.0.5",
    "postcss": "^8.5.33",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
